# MIMO LLM配置（必填）
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# JWT认证密钥（必填，生产环境请务必修改为强密钥）
JWT_SECRET_KEY=your-secret-key-change-in-production

# Tavily搜索配置（可选，启用网络搜索功能需要）
TAVILY_API_KEY=your_tavily_api_key_here

# ChromaDB配置（路径由 settings.py 自动计算，通常无需修改）
CHROMA_COLLECTION_NAME=enterprise_knowledge

# 文档处理配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Reranker配置（可选，开启需下载模型约1.3GB）
# RERANKER_ENABLED=false

# 质量评估配置（规则检查，无额外模型加载，延迟<100ms）
# EVAL_ENABLED=false
# EVAL_FAITHFULNESS_THRESHOLD=0.70
# EVAL_RELEVANCY_THRESHOLD=0.50
# EVAL_DEGRADATION_STRATEGY=retry

# 自动重试配置（默认1次重试，最多2次尝试，避免超时）
# AGENT_MAX_RETRIES=1
